# libvpx commit: 12f3a2ac603e8f10742105519e0cd03c3b8f71dd (v1.14.1)
# F.0.2 — per-block picker-decision oracle (HLD §3.3).
#
# Adds additive, output-only instrumentation to `vp9_pick_inter_mode` in
# vp9/encoder/vp9_pickmode.c (the per-block picker that runs once per
# coded block in libvpx's real-time path). The fprintf is gated on the
# `VPX_F02_ORACLE_OUT` environment variable so unpatched / non-F.0.2
# runs of the patched binary are byte-identical to stock. No behaviour
# change: no early-returns, no mutations to the picker's locals.
#
# Output format: one JSONL object per line, matching the schema in
# `crates/rvp9-encoder/src/f02_oracle.rs` (HLD §3.4). Both legs
# serialise the same shape so the diff binary can pair records by
# (frame_idx, mi_row, mi_col).
#
# Output buffering: `setvbuf(_IOLBF)` (HLD §3.3 revision 6) — each
# fprintf line lands atomically when the patched vpxenc is invoked
# from the harness driver, avoiding the partial-flush interleaving
# Windows stdio default `_IOFBF` produces.
#
# Rate-component fields report the winning candidate's live mode, MV,
# selected-reference, switchable-filter, and skip syntax costs. The raw luma
# and UV model fields remain separate so analysis never has to infer one
# component by subtracting from the final rate.
#
# Reference-cost diagnostics append the neighbour-selected contexts, active
# probabilities, and four `init_ref_frame_cost` outputs. The existing parser
# deliberately ignores unknown fields, preserving the base F.0.2 schema.
#
# Applying:
#   cd third_party/libvpx
#   git apply ../libvpx-patches/f02_oracle.patch
# Build via `scripts/build_f02_libvpx.ps1` (HLD §3.3 revision 5).
diff --git a/vp9/encoder/vp9_pickmode.c b/vp9/encoder/vp9_pickmode.c
--- a/vp9/encoder/vp9_pickmode.c
+++ b/vp9/encoder/vp9_pickmode.c
@@ -10,6 +10,7 @@

 #include <assert.h>
 #include <limits.h>
+#include <stdlib.h>
 #include <math.h>
 #include <stdio.h>

@@ -1746,6 +1747,16 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
   int skip_ref_find_pred[4] = { 0 };
   unsigned int sse_zeromv_normalized = UINT_MAX;
   unsigned int best_sse_sofar = UINT_MAX;
+  unsigned int best_pred_sse_f02 = UINT_MAX;
+  unsigned int best_model_var_f02 = UINT_MAX;
+  int best_luma_rate_f02 = 0;
+  int64_t best_luma_dist_f02 = 0;
+  int best_uv_rate_f02 = 0;
+  int64_t best_uv_dist_f02 = 0;
+  int current_luma_rate_f02 = 0;
+  int64_t current_luma_dist_f02 = 0;
+  int current_uv_rate_f02 = 0;
+  int64_t current_uv_dist_f02 = 0;
   int gf_temporal_ref = 0;
   int force_test_gf_zeromv = 0;
 #if CONFIG_VP9_TEMPORAL_DENOISING
@@ -2347,6 +2358,8 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
       this_sse = (int64_t)sse_y;
       block_yrd(cpi, x, &this_rdc, &is_skippable, &this_sse, bsize,
                 VPXMIN(mi->tx_size, TX_16X16), rd_computed, 0);
+      current_luma_rate_f02 = this_rdc.rate;
+      current_luma_dist_f02 = this_rdc.dist;
       x->skip_txfm[0] = is_skippable;
       if (is_skippable) {
         this_rdc.rate = vp9_cost_bit(vp9_get_skip_prob(cm, xd), 1);
@@ -2374,6 +2387,12 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
       }
       this_rdc.rate += vp9_cost_bit(vp9_get_skip_prob(cm, xd), 1);
     }
+    if (this_early_term) {
+      current_luma_rate_f02 = this_rdc.rate;
+      current_luma_dist_f02 = this_rdc.dist;
+    }
+    current_uv_rate_f02 = 0;
+    current_uv_dist_f02 = 0;
-
+
     if (!this_early_term &&
         (x->color_sensitivity[0] || x->color_sensitivity[1])) {
@@ -2391,5 +2410,7 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
       }
       model_rd_for_sb_uv(cpi, uv_bsize, x, xd, &rdc_uv, &var_y, &sse_y, 1, 2);
+      current_uv_rate_f02 = rdc_uv.rate;
+      current_uv_dist_f02 = rdc_uv.dist;
       this_rdc.rate += rdc_uv.rate;
       this_rdc.dist += rdc_uv.dist;
     }
@@ -2448,6 +2469,12 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,

     if (this_rdc.rdcost < best_rdc.rdcost || x->skip) {
       best_rdc = this_rdc;
+      best_pred_sse_f02 = sse_y;
+      best_model_var_f02 = var_y;
+      best_luma_rate_f02 = current_luma_rate_f02;
+      best_luma_dist_f02 = current_luma_dist_f02;
+      best_uv_rate_f02 = current_uv_rate_f02;
+      best_uv_dist_f02 = current_uv_dist_f02;
       best_early_term = this_early_term;
       best_pickmode.best_mode = this_mode;
       best_pickmode.best_pred_filter = mi->interp_filter;
@@ -2626,5 +2653,9 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
       if (this_rdc.rdcost < best_rdc.rdcost) {
         best_rdc = this_rdc;
+        best_luma_rate_f02 = 0;
+        best_luma_dist_f02 = 0;
+        best_uv_rate_f02 = 0;
+        best_uv_dist_f02 = 0;
         best_pickmode.best_mode = this_mode;
         best_pickmode.best_intra_tx_size = mi->tx_size;
         best_pickmode.best_ref_frame = INTRA_FRAME;
@@ -2735,8 +2766,172 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
       }
     }
   }

   *rd_cost = best_rdc;
+
+  /* F.0.2 ORACLE BEGIN — additive instrumentation only; no behaviour
+   * change. Emits one JSONL line per coded block to the file named in
+   * `VPX_F02_ORACLE_OUT`. Off-by-default; when the env var is unset
+   * the patched binary is byte-identical to stock. See
+   * `wrk_docs/Track_F/F0.2_HLD_per_block_oracle.md` §3.3 for the full
+   * design rationale. */
+  {
+    static FILE *vpx_f02_fp = NULL;
+    static int vpx_f02_state = 0; /* 0=not-tried, 1=open-ok, 2=open-failed */
+    static const char *const vpx_f02_bsize_tag[BLOCK_SIZES] = {
+      "4x4",   "4x8",   "8x4",   "8x8",   "8x16",  "16x8",  "16x16",
+      "16x32", "32x16", "32x32", "32x64", "64x32", "64x64"
+    };
+    static const char *const vpx_f02_tx_size_tag[TX_SIZES] = {
+      "4x4", "8x8", "16x16", "32x32"
+    };
+    static const char *const vpx_f02_mode_tag[MB_MODE_COUNT] = {
+      "DC", "V", "H", "D45", "D135", "D117", "D153", "D207", "D63", "TM",
+      "NEARESTMV", "NEARMV", "ZEROMV", "NEWMV"
+    };
+    if (vpx_f02_state == 0) {
+      const char *out_path = getenv("VPX_F02_ORACLE_OUT");
+      if (out_path != NULL && out_path[0] != '\0') {
+        vpx_f02_fp = fopen(out_path, "w");
+        if (vpx_f02_fp != NULL) {
+          /* HLD §3.3 revision 6: line-buffered output so per-block
+           * writes land atomically on Windows stdio (default _IOFBF
+           * partial-flush interleaves when the harness drains stderr
+           * concurrently). */
+          setvbuf(vpx_f02_fp, NULL, _IOLBF, 0);
+          vpx_f02_state = 1;
+        } else {
+          vpx_f02_state = 2;
+        }
+      } else {
+        vpx_f02_state = 2; /* env not set — disabled for this run */
+      }
+    }
+    if (vpx_f02_state == 1 && vpx_f02_fp != NULL) {
+      const char *bsize_str = (bsize < BLOCK_SIZES)
+                                  ? vpx_f02_bsize_tag[bsize] : "?";
+      PREDICTION_MODE picked_mode = mi->mode;
+      const char *mode_str = (picked_mode < MB_MODE_COUNT)
+                                 ? vpx_f02_mode_tag[picked_mode] : "?";
+      MV_REFERENCE_FRAME picked_ref = mi->ref_frame[0];
+      const char *ref_str;
+      switch (picked_ref) {
+        case INTRA_FRAME: ref_str = "INTRA"; break;
+        case LAST_FRAME:  ref_str = "LAST"; break;
+        case GOLDEN_FRAME:ref_str = "GOLDEN"; break;
+        case ALTREF_FRAME:ref_str = "ALTREF"; break;
+        default: ref_str = "NONE"; break;
+      }
+      const char *filter_str = "NONE";
+      if (picked_ref != INTRA_FRAME) {
+        switch (mi->interp_filter) {
+          case EIGHTTAP: filter_str = "EIGHTTAP"; break;
+          case EIGHTTAP_SMOOTH: filter_str = "EIGHTTAP_SMOOTH"; break;
+          case EIGHTTAP_SHARP: filter_str = "EIGHTTAP_SHARP"; break;
+          case BILINEAR: filter_str = "BILINEAR"; break;
+          default: filter_str = "NONE"; break;
+        }
+      }
+      int mv_row = (picked_ref == INTRA_FRAME) ? 0
+                                               : (int)mi->mv[0].as_mv.row;
+      int mv_col = (picked_ref == INTRA_FRAME) ? 0
+                                               : (int)mi->mv[0].as_mv.col;
+      int mode_bits_est = picked_ref == INTRA_FRAME
+                               ? 0
+                               : cpi->inter_mode_cost
+                                     [x->mbmi_ext->mode_context[picked_ref]]
+                                     [INTER_OFFSET(picked_mode)];
+      int mv_bits_est = 0;
+      if (picked_ref != INTRA_FRAME && picked_mode == NEWMV) {
+        mv_bits_est = vp9_mv_bit_cost(
+            &mi->mv[0].as_mv, &x->mbmi_ext->ref_mvs[picked_ref][0].as_mv,
+            x->nmvjointcost, x->mvcost, MV_COST_WEIGHT);
+      }
+      int ref_bits_est =
+          picked_ref == INTRA_FRAME ? 0 : ref_frame_cost[picked_ref];
+      int filter_bits_est =
+          picked_ref != INTRA_FRAME && cm->interp_filter == SWITCHABLE &&
+                  ((mi->mv[0].as_mv.row | mi->mv[0].as_mv.col) & 0x07)
+              ? vp9_get_switchable_rate(cpi, xd)
+              : 0;
+      int skip_bits_est =
+          picked_ref == INTRA_FRAME
+              ? 0
+              : vp9_cost_bit(vp9_get_skip_prob(cm, xd),
+                             x->skip_txfm[0] != SKIP_TXFM_NONE);
+      /* Winning candidate's pre-quant source-vs-prediction SSE. */
+      unsigned long long sse_after_pred =
+          picked_ref == INTRA_FRAME ? 0 : (unsigned long long)best_pred_sse_f02;
+      int skip_flag = mi->skip;
+      const char *tx_size_str = (mi->tx_size < TX_SIZES)
+                                    ? vpx_f02_tx_size_tag[mi->tx_size] : "?";
+      int luma_eob_nonzero =
+          !skip_flag && x->skip_txfm[0] == SKIP_TXFM_NONE;
+      int intra_inter_ctx_f02 = get_intra_inter_context(xd);
+      int single_ref_p1_ctx_f02 =
+          vp9_get_pred_context_single_ref_p1(xd);
+      int single_ref_p2_ctx_f02 =
+          vp9_get_pred_context_single_ref_p2(xd);
+      int intra_inter_prob_f02 =
+          cm->fc->intra_inter_prob[intra_inter_ctx_f02];
+      int single_ref_p1_prob_f02 =
+          cm->fc->single_ref_prob[single_ref_p1_ctx_f02][0];
+      int single_ref_p2_prob_f02 =
+          cm->fc->single_ref_prob[single_ref_p2_ctx_f02][1];
+      /* `frame_idx` mirrors the harness binary's IVF-presentation-
+       * order counter; libvpx tracks it as `cm->current_video_frame`. */
+      unsigned int frame_idx = (unsigned int)cm->current_video_frame;
+      fprintf(vpx_f02_fp,
+              "{\"frame_idx\":%u,\"mi_row\":%d,\"mi_col\":%d,"
+              "\"bsize\":\"%s\",\"mode\":\"%s\",\"ref_frame\":\"%s\","
+              "\"mv_row\":%d,\"mv_col\":%d,"
+              "\"mode_bits_est\":%d,\"mv_bits_est\":%d,"
+              "\"ref_bits_est\":%d,\"filter_bits_est\":%d,"
+              "\"skip_bits_est\":%d,\"coef_bits_est\":0,"
+              "\"picker_rate\":%d,\"picker_dist\":%lld,"
+              "\"picker_rd_cost\":%lld,\"model_var_y\":%u,"
+              "\"model_tx_size\":\"%s\",\"model_skip_txfm\":%d,"
+              "\"luma_coef_rate\":%d,\"luma_coef_dist\":%lld,"
+              "\"uv_model_rate\":%d,\"uv_model_dist\":%lld,"
+              "\"uv_u_sensitive\":%s,\"uv_v_sensitive\":%s,"
+              "\"partition_u_sensitive\":%s,\"partition_v_sensitive\":%s,"
+              "\"sse_after_pred\":%llu,\"interp_filter\":\"%s\","
+              "\"skip_flag\":%s,\"q_index\":%d,\"tx_size\":\"%s\","
+              "\"luma_eob_nonzero\":%s,"
+              "\"intra_inter_ctx\":%d,\"single_ref_p1_ctx\":%d,"
+              "\"single_ref_p2_ctx\":%d,\"intra_inter_prob\":%d,"
+              "\"single_ref_p1_prob\":%d,\"single_ref_p2_prob\":%d,"
+              "\"ref_cost_intra\":%d,\"ref_cost_last\":%d,"
+              "\"ref_cost_golden\":%d,\"ref_cost_altref\":%d}\n",
+              frame_idx, mi_row, mi_col,
+              bsize_str, mode_str, ref_str,
+              mv_row, mv_col,
+              mode_bits_est, mv_bits_est, ref_bits_est, filter_bits_est,
+              skip_bits_est,
+              best_rdc.rate, (long long)best_rdc.dist,
+              (long long)best_rdc.rdcost,
+              picked_ref == INTRA_FRAME ? 0 : best_model_var_f02,
+              tx_size_str, x->skip_txfm[0],
+              best_luma_rate_f02, (long long)best_luma_dist_f02,
+              best_uv_rate_f02, (long long)best_uv_dist_f02,
+              x->color_sensitivity[0] ? "true" : "false",
+              x->color_sensitivity[1] ? "true" : "false",
+              x->color_sensitivity[0] ? "true" : "false",
+              x->color_sensitivity[1] ? "true" : "false",
+              sse_after_pred,
+              filter_str,
+              skip_flag ? "true" : "false",
+              x->q_index,
+              tx_size_str,
+              luma_eob_nonzero ? "true" : "false",
+              intra_inter_ctx_f02, single_ref_p1_ctx_f02,
+              single_ref_p2_ctx_f02, intra_inter_prob_f02,
+              single_ref_p1_prob_f02, single_ref_p2_prob_f02,
+              ref_frame_cost[INTRA_FRAME], ref_frame_cost[LAST_FRAME],
+              ref_frame_cost[GOLDEN_FRAME], ref_frame_cost[ALTREF_FRAME]);
+    }
+  }
+  /* F.0.2 ORACLE END */
 }

 void vp9_pick_inter_mode_sub8x8(VP9_COMP *cpi, MACROBLOCK *x, int mi_row,
                                 int mi_col, RD_COST *rd_cost, BLOCK_SIZE bsize,
                                 PICK_MODE_CONTEXT *ctx) {
