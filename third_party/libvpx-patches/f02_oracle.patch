       best_early_term = this_early_term;
@@ -2627,2 +2690,6 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
         best_rdc = this_rdc;
+        best_luma_rate_f02 = 0;
