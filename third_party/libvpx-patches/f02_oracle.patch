+  int candidate_luma_rate_f02[4] = { 0 };
+  int64_t candidate_luma_dist_f02[4] = { 0 };
+  int candidate_uv_rate_f02[4] = { 0 };
+  int64_t candidate_uv_dist_f02[4] = { 0 };
+  int candidate_skip_f02[4] = { 0 };
   int gf_temporal_ref = 0;
@@ -2350,2 +2372,4 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
                 VPXMIN(mi->tx_size, TX_16X16), rd_computed, 0);
+      current_luma_rate_f02 = this_rdc.rate;
