         best_pickmode.best_mode = this_mode;
@@ -2741,2 +2808,193 @@ void vp9_pick_inter_mode(VP9_COMP *cpi, MACROBLOCK *x, TileDataEnc *tile_data,
   *rd_cost = best_rdc;
+
+  /* F.0.2 ORACLE BEGIN — additive instrumentation only; no behaviour
+   * change. Emits one JSONL line per coded block to the file named in
