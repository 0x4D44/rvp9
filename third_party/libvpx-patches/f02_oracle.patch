+static void f02_block_yrd_oracle(VP9_COMP *cpi, MACROBLOCK *x,
+                                 BLOCK_SIZE bsize, TX_SIZE tx_size,
+                                 const RD_COST *rdc, int skippable) {
+  static FILE *fp = NULL;
+  static int state = 0; /* 0=not-tried, 1=open-ok, 2=disabled/failed */
+  static long limit = 64;
+  static long count = 0;
+  MACROBLOCKD *const xd = &x->e_mbd;
+  struct macroblock_plane *const p = &x->plane[0];
+  const struct macroblockd_plane *const pd = &xd->plane[0];
+  const int num_4x4_w = num_4x4_blocks_wide_lookup[bsize];
+  const int num_4x4_h = num_4x4_blocks_high_lookup[bsize];
+  const int block_step = 1 << tx_size;
+  const int step = 1 << (tx_size << 1);
+  const int max_blocks_wide =
+      num_4x4_w + (xd->mb_to_right_edge >= 0 ? 0 : xd->mb_to_right_edge >> 5);
+  const int max_blocks_high =
+      num_4x4_h + (xd->mb_to_bottom_edge >= 0
+                       ? 0
+                       : xd->mb_to_bottom_edge >> 5);
+  int block;
+  int r;
+  int c;
+  int i;
+  int tile_count = 0;
+  int first;
+
+  if (state == 0) {
+    const char *const out_path = getenv("VPX_F02_BLOCK_YRD_ORACLE_OUT");
+    const char *const limit_text = getenv("VPX_F02_BLOCK_YRD_ORACLE_LIMIT");
+    if (limit_text != NULL && limit_text[0] != '\0') {
+      char *end = NULL;
+      const long parsed = strtol(limit_text, &end, 10);
+      if (end != limit_text && *end == '\0' && parsed > 0) limit = parsed;
+    }
+    if (out_path != NULL && out_path[0] != '\0') {
+      fp = fopen(out_path, "w");
+      if (fp != NULL) {
+        setvbuf(fp, NULL, _IOLBF, 0);
+        state = 1;
+      } else {
+        state = 2;
+      }
+    } else {
+      state = 2;
+    }
+  }
+
+  if (state != 1 || fp == NULL || count >= limit || skippable ||
+      xd->mi[0]->ref_frame[0] != LAST_FRAME) {
+    return;
+  }
+
+  for (r = 0; r < max_blocks_high; r += block_step) {
+    for (c = 0; c < num_4x4_w; c += block_step) {
+      if (c < max_blocks_wide) ++tile_count;
+    }
+  }
+
