+static unsigned int f02_current_qcoeff_nonzero;
+
+static uint64_t f02_hash_coeff(uint64_t hash, tran_low_t value) {
+  uint32_t bits = (uint32_t)(int32_t)value;
+  int byte;
+  for (byte = 0; byte < 4; ++byte) {
+    hash ^= bits & 0xff;
+    hash *= 1099511628211ULL;
+    bits >>= 8;
+  }
+  return hash;
+}
