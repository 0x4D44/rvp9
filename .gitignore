# Cargo / Rust
target/
target_ci/
**/*.rs.bk
Cargo.lock.bak

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code agent worktrees (per-agent isolated copies of the repo
# that the harness manages). Path is created on demand under .claude/.
.claude/

# Ad-hoc profiler dumps (e.g. .profile/tile_t1_t4.tsv) — host-specific
# samples produced by perf/superluminal runs, not part of the codebase.
.profile/
# Superluminal/profile JSON exports written at repo root by ad-hoc
# capture scripts (e.g. profile_headline.json.gz, profile_t1.json.gz,
# profile_*.json.syms.json). Host-specific samples — never commit.
/profile_*.json.gz
/profile_*.json.syms.json

# OS
Thumbs.db
.DS_Store

# Build artifacts from old layout (pre-workspace) — anchored to repo root
# so Cargo's src/bin/ directories are NOT excluded.
/bin/
/obj/
venv/
.venv/
env/
*.tmp
*.log

# Python bytecode cache (e.g. scripts/__pycache__/*.pyc from running
# scripts/psnr_per_frame.py etc).
__pycache__/
*.pyc

# Test data — gitignored, fetched by scripts/
tests/conformance/vectors/
# Real-world corpus (HLD §G8):
#   - sources/  : raw .y4m / mkv source clips, fetched by
#                 scripts/fetch-corpus.{sh,ps1} (gitignored — too large).
#                 Sole exception: the README that documents the layout
#                 stays committed via the negation rule below.
#   - fixtures/ : small curated subset of encoded .ivf + .md5 pairs
#                 committed in-repo. NOT gitignored.
tests/corpus/sources/*
!tests/corpus/sources/README.md
# Raw .y4m sources sometimes get staged into tests/corpus/ root (e.g.
# `testsrc_*.y4m`) by ad-hoc encode-corpus dry runs. They're hundreds of
# MB each; never commit them.
tests/corpus/*.y4m
# T-2 Profile-1 intermediate re-chroma'd sources (regenerable via ffmpeg
# from the parent y4m). 30 frames @ 720p444 = ~80MB — too large to commit.
# The two committed exceptions (`foreman_c422.y4m`, `foreman_c444.y4m`)
# pre-date Track T and are small enough.
tests/corpus/profile1/testsrc_*.y4m
# Raw .yuv intermediate files for Profile-1 encoding (e.g. foreman_c440.yuv
# for 4:4:0, since y4m format doesn't support yuv440p).
tests/corpus/profile1/*.yuv
# Q.1.A regenerable fixtures (HLD §7): encoded by
# scripts/bench-headtohead.ps1 from the gitignored .y4m sources.
tests/corpus/fixtures/testsrc_*.ivf
tests/corpus/fixtures/testsrc_*.ivf.md5
tests/corpus/fixtures/testsrc_*.ivf.ffmpeg.md5

# Benchmark output (host-specific dev-box runs). The committed
# `decode-throughput.csv` baseline is the exception — per HLD §G6 the
# ratchet test reads it as the last-committed baseline, so it MUST be
# tracked. Other ad-hoc files under bench/results/ remain ignored.
bench/results/*
!bench/results/decode-throughput.csv
# Q.1.A head-to-head ledger (HLD §7): regenerated by
# scripts/bench-headtohead.ps1 each run; .md is overwritten, .csv is
# append-only schema-v1 trend.
!bench/results/decode-headtohead.md
!bench/results/decode-headtohead.csv

# rvp9-fuzz — libFuzzer corpus + crash artifacts (source is committed,
# working state is not). Per HLD §G9; corpus is seeded by
# scripts/setup-fuzz-corpus.ps1.
crates/rvp9-fuzz/corpus/
crates/rvp9-fuzz/artifacts/
crates/rvp9-fuzz/coverage/
# Standalone-workspace target dir for the fuzz crate (the empty
# `[workspace]` in `crates/rvp9-fuzz/Cargo.toml` makes cargo-fuzz
# resolve its own target/ here, separate from the repo-root target/.
# Both must be excluded; the root `target/` rule above doesn't match
# this path because it isn't anchored at the crate root.
crates/rvp9-fuzz/target/

# libvpx build outputs live at /build/libvpx/ (NOT inside the submodule —
# that path collides with libvpx's source-tree `build/` directory).
/build/
third_party/libvpx/*.exe
third_party/libvpx/*.o
third_party/libvpx/*.a
third_party/libvpx/*.d
bench/r*_full.tsv
