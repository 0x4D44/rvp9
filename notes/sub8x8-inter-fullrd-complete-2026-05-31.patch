     }
 }
 
+/// SUB8 — splat a sub-8x8 (`Block8x8` coded as 4 sub-blocks) leaf into
+/// the in-progress mi_grid. The cell carries `block_size = Block4x4` +
+/// the per-sub-block `bmi`; the parent `mode`/`mvs` inherit `bmi[3]`
+/// (last sub-block), matching the decoder's `resolve_sub8_bmi`. This
+/// must match `frame_loop::build_inter_mi_grid_from_picker`'s sub8 cell
+/// so the in-progress neighbour grid (and the next frame's prev-MV grid)
+/// see exactly what the writer + decoder will.
+fn splat_sub8_leaf_into_mi_grid(
+    mi_grid: &mut [Option<rvp9_core::mode_info::ModeInfo>],
+    mi_cols: usize,
+    leaf_mi_row: usize,
+    leaf_mi_col: usize,
+    segment_id: u8,
+    skip: bool,
+    picked_ref_frame: RefFrame,
+    picked_interp_filter: rvp9_core::bitstream::frame::InterpFilter,
+    bmi: [rvp9_core::mode_info::BmiInfo; 4],
+) {
+    use rvp9_core::mode_info::{BlockMode, InterMode, ModeInfo};
+    let last = bmi[3];
+    let parent_mode = InterMode::from_idx(last.as_mode).unwrap_or(InterMode::ZeroMv);
+    let cell = ModeInfo {
+        block_size: BlockSize::Block4x4,
+        tx_size: rvp9_core::transforms::TxSize::Tx4x4,
+        skip,
+        segment_id,
+        seg_id_predicted: false,
+        mode: BlockMode::Inter {
+            mode: parent_mode,
+            ref_frames: [picked_ref_frame, RefFrame::NoRefFrame],
+            mvs: last.as_mv,
+            interp_filter: picked_interp_filter,
+        },
+        bmi,
+    };
+    // A `Block8x8` leaf covers a single 8x8 mi cell.
+    mi_grid[leaf_mi_row * mi_cols + leaf_mi_col] = Some(cell);
+}
+
+/// SUB8 — inter-mode + MV signalling rate for the single-8x8 baseline,
+/// shaped to match the per-sub-block `mv_mode_rate` the sub-8x8 picker
+/// uses (inter-mode cost + NEWMV MV-delta cost; NEAREST/NEAR/ZERO pay
+/// only the mode cost). The ref-frame cost is omitted because both
+/// candidates are single-ref LAST (it cancels in the comparison).
+fn real_mode_rate_for_single(
+    inter_costs: &rvp9_core::cost::symbol_costs::InterModeCosts,
+    ctx: usize,
+    mode: InterMode,
+    mv: Mv,
+    ref_mv: Mv,
+    mv_costs: &rvp9_core::cost::mv_cost::MvCosts,
+) -> u32 {
+    let ctx = ctx.min(rvp9_core::entropy::default_probs::INTER_MODE_CONTEXTS - 1);
+    let mode_cost = inter_costs[ctx][mode.idx()].max(0) as u32;
+    let mv_rate = if matches!(mode, InterMode::NewMv) {
+        let dr = mv.row.wrapping_sub(ref_mv.row);
+        let dc = mv.col.wrapping_sub(ref_mv.col);
+        let raw = rvp9_core::cost::mv_cost::mv_cost(dr, dc, mv_costs).max(0) as i64;
+        ((raw * 108 + 64) >> 7).min(i64::from(u32::MAX)) as u32
+    } else {
+        0
+    };
+    mode_cost.saturating_add(mv_rate)
+}
+
+/// SUB8 — RD-pick a sub-8x8 alternative for a committed `Block8x8`
+/// inter leaf and, if it wins, overwrite the leaf's recon (Y + chroma)
+/// and coef-source in place, then mark the leaf desc as sub-8x8.
+///
+/// The single-8x8 recon + coefs are already committed by the caller; we
+/// compute the single-8x8 Y RD baseline with the same transform-domain
+/// construction the sub-8x8 picker uses, then only commit sub-8x8 if it
+/// strictly beats that baseline. The per-sub-block recon mirrors the
+/// decoder's `reconstruct_inter` exactly (4 Y 4×4 sub-blocks at each
+/// `bmi[j].as_mv[0]`; one 4:2:0 chroma 4×4 at the Q4-averaged MV).
+#[allow(clippy::too_many_arguments)]
+fn try_commit_sub8x8<N: rvp9_core::inter::mv_ref::NeighbourLookup>(
+    src_y: &rvp9_core::mv_search::PlaneRef<'_>,
+    leaf_px: (usize, usize),
+    ref_y: &rvp9_core::mv_search::PlaneRef<'_>,
+    input_uv: (&[u8], &[u8]),
+    last_recon_yuv: (&[u8], &[u8], &[u8]),
+    recon_y_out: &mut [u8],
+    recon_u_out: &mut [u8],
+    recon_v_out: &mut [u8],
+    coef_source: &mut VecBackedInterCoefSource,
+    leaf_mi_row: usize,
+    leaf_mi_col: usize,
+    parent_mv: Mv,
+    interp_filter: rvp9_core::bitstream::frame::InterpFilter,
+    quantizer: &rvp9_core::quant::forward::PlaneQuantizers,
+    coef_costs: &rvp9_core::cost::coef_cost::CoefCostTable,
+    rdmult: i64,
+    newmv_ref_mv: Mv,
+    single_mode_mv_rate: u32,
+    mv_limits: rvp9_core::mv_search::mv_limits::MvLimits,
+    mv_costs: &rvp9_core::cost::mv_cost::MvCosts,
+    inter_costs: &rvp9_core::cost::symbol_costs::InterModeCosts,
+    inter_mode_ctx: usize,
+    neighbours: &N,
+    sign_bias: &[bool; 4],
+    bounds: &rvp9_core::inter::mv_ref::BlockBounds,
+    prev_mv: Option<rvp9_core::inter::mv_ref::PrevFrameMvRef>,
+    w: usize,
+    h: usize,
+    uvw: usize,
+    uvh: usize,
+    leaf: &mut InterPartitionLeafDesc,
+    leaf_total_eob: &mut usize,
+) {
+    use crate::rdo::sub8_encode::{
+        Sub8x8PickInput, bmi_from_decision, chroma_mv_q4_avg, pick_sub8x8_for_block8x8,
+    };
+
+    // The decision RD (Y + chroma, real propagating coef context) is
+    // computed inside `pick_sub8x8_for_block8x8`: it returns `Some` only
+    // when the FULL sub-8x8 RD strictly beats the FULL single-8x8 RD.
+    // Both sides include chroma (single-8x8 at the parent MV; sub-8x8 at
+    // the decoder-faithful Q4-averaged MV `try_commit_sub8x8`
+    // reconstructs with), so the comparison is apples-to-apples and the
+    // feature self-suppresses where the averaged-chroma penalty (or the
+    // 4-way coef overhead) makes it not pay. No acceptance margin is
+    // needed once the RD is accurate; the unused diagnostic knob remains
+    // available below.
+    let _ = (single_mode_mv_rate, newmv_ref_mv, sub8_margin_pct());
+
+    // The writer's NEWMV ref MV (shared across sub-blocks). Recompute it
+    // from `write_sub8_bmi`'s exact formula so the MV-delta the picker
+    // costs (and the NEWMV search centre) match what the writer emits.
+    let writer_ref_mv = crate::rdo::sub8_encode::newmv_ref_mv_for_sub8(
+        neighbours, sign_bias, bounds, prev_mv, /* allow_hp = */ false,
+    );
+
+    // Per-mode inter-mode signalling cost for the sub-block RD (each
+    // sub-block pays `cost_mv_ref` once). Same context as the parent.
+    let ctx = inter_mode_ctx.min(rvp9_core::entropy::default_probs::INTER_MODE_CONTEXTS - 1);
+    let inter_mode_cost = [
+        inter_costs[ctx][0].max(0) as u32,
+        inter_costs[ctx][1].max(0) as u32,
+        inter_costs[ctx][2].max(0) as u32,
+        inter_costs[ctx][3].max(0) as u32,
+    ];
+
+    // Chroma plane top-left for this leaf (4:2:0 → half luma).
+    let input = Sub8x8PickInput {
+        src_y: *src_y,
+        src_offset: leaf_px,
+        ref_y: *ref_y,
+        src_u: input_uv.0,
+        src_v: input_uv.1,
+        ref_u: last_recon_yuv.1,
+        ref_v: last_recon_yuv.2,
+        uvw,
+        uvh,
+        interp_filter,
+        quant: quantizer,
+        coef_costs,
+        rdmult,
+        mv_limits,
+        mv_costs,
+        newmv_ref_mv: writer_ref_mv,
+        parent_mv,
+        inter_mode_cost,
+    };
+    let decision = match pick_sub8x8_for_block8x8(&input, neighbours, sign_bias, bounds, prev_mv) {
+        Some(d) => d,
+        None => return, // sub-8x8 didn't beat the single-8x8 baseline
+    };
+
+    // 3. Sub-8x8 won. Build the per-sub-block bmi and re-reconstruct the
+    //    leaf's Y + chroma into `recon_yuv_out`, overwriting the
+    //    single-8x8 recon, and re-insert the 4×4 coefs.
+    let bmi = bmi_from_decision(&decision);
+    crate::rdo::inter_dispatch::SUB8_LEAVES_EMITTED
+        .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+
+    let mut new_eob: usize = 0;
+    let (leaf_px_x, leaf_px_y) = leaf_px;
+
+    // --- Y plane: 4 sub-blocks of 4×4, each its own MV. -------------
+    {
+        let recon_y: &mut [u8] = recon_y_out;
+        for j in 0..4usize {
+            let sub_x = j % 2;
+            let sub_y = j / 2;
+            let px_x = leaf_px_x + sub_x * 4;
+            let px_y = leaf_px_y + sub_y * 4;
+            let mv = bmi[j].as_mv[0];
+            // Y: ss = 0 → mv_q4 = mv * 2.
+            let mv_q4_col = i32::from(mv.col) * 2;
+            let mv_q4_row = i32::from(mv.row) * 2;
+            build_inter_pred_plane_unscaled(
+                last_recon_yuv.0,
+                w,
+                w,
+                h,
+                px_x,
+                px_y,
+                4,
+                4,
+                mv_q4_col,
+                mv_q4_row,
+                recon_y,
+                w,
+                interp_filter,
+                false,
+            );
+            // Residual = src - pred (recon currently holds the pred).
+            let mut residual = [0i16; 16];
+            for r in 0..4 {
+                for c in 0..4 {
+                    let off = (px_y + r) * w + (px_x + c);
+                    residual[r * 4 + c] =
+                        i16::from(src_y.data[(leaf_px_y + sub_y * 4 + r) * src_y.stride
+                            + (leaf_px_x + sub_x * 4 + c)])
+                            - i16::from(recon_y[off]);
+                }
+            }
+            let (qcoeff, dqcoeff, eob) = inter_forward_quant_one_tx(
+                &residual,
+                4,
+                rvp9_core::transforms::TxSize::Tx4x4,
+                quantizer,
+                0, // plane_type: Y
+                None,
+            );
+            if eob > 0 {
+                let dst_off = px_y * w + px_x;
+                inter_inverse_dct_add(
+                    rvp9_core::transforms::TxSize::Tx4x4,
+                    &dqcoeff,
+                    eob,
+                    &mut recon_y[dst_off..],
+                    w,
+                );
+            }
+            coef_source.insert(leaf_mi_row, leaf_mi_col, 0, sub_x, sub_y, qcoeff, eob);
+            new_eob += eob;
+        }
+    }
+
+    // --- Chroma (4:2:0): one 4×4 sub-block at the Q4-averaged MV. ----
+    let chroma_mv = chroma_mv_q4_avg(&bmi);
+    // ss = 1 → mv_q4 = mv * (1 << (1 - 1)) = mv * 1 (no-op for 4:2:0).
+    let cmv_q4_col = i32::from(chroma_mv.col);
+    let cmv_q4_row = i32::from(chroma_mv.row);
+    let c_px_x = (leaf_mi_col * 8) >> 1;
+    let c_px_y = (leaf_mi_row * 8) >> 1;
+    for plane in 1..3usize {
+        let (input_uv_plane, ref_uv, recon_uv): (&[u8], &[u8], &mut [u8]) = if plane == 1 {
+            (input_uv.0, last_recon_yuv.1, &mut *recon_u_out)
+        } else {
+            (input_uv.1, last_recon_yuv.2, &mut *recon_v_out)
+        };
+        build_inter_pred_plane_unscaled(
+            ref_uv, uvw, uvw, uvh, c_px_x, c_px_y, 4, 4, cmv_q4_col, cmv_q4_row, recon_uv, uvw,
+            interp_filter, false,
+        );
+        // Residual = input - pred (recon holds the pred).
+        let mut residual = [0i16; 16];
+        for r in 0..4 {
+            for c in 0..4 {
+                let off = (c_px_y + r) * uvw + (c_px_x + c);
+                residual[r * 4 + c] =
+                    i16::from(input_uv_plane[off]) - i16::from(recon_uv[off]);
+            }
+        }
+        let (qcoeff, dqcoeff, eob) = inter_forward_quant_one_tx(
+            &residual,
+            4,
+            rvp9_core::transforms::TxSize::Tx4x4,
+            quantizer,
+            1, // plane_type: chroma
+            None,
+        );
+        if eob > 0 {
+            let dst_off = c_px_y * uvw + c_px_x;
+            inter_inverse_dct_add(
+                rvp9_core::transforms::TxSize::Tx4x4,
+                &dqcoeff,
+                eob,
+                &mut recon_uv[dst_off..],
+                uvw,
+            );
+        }
+        coef_source.insert(leaf_mi_row, leaf_mi_col, plane, 0, 0, qcoeff, eob);
+        new_eob += eob;
+    }
+
+    // 4. Commit the leaf as sub-8x8.
+    leaf.sub8_bmi = Some(bmi);
+    leaf.picked_tx_size = rvp9_core::transforms::TxSize::Tx4x4;
+    leaf.skip = false;
