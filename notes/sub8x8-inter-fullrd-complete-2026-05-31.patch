+/// SUB8 (`RVP9_SUB8`) — sub-8x8 inter prediction gate. Default OFF
+/// (byte-identical baseline). When set to a truthy value (`1`, `on`,
+/// `true`) the cpu<=4 RDO inter path RD-picks coding each `Block8x8`
+/// inter leaf as four 4×4 sub-blocks with per-sub-block MVs
+/// (libvpx `rd_pick_best_sub8x8_mode`). Read once (per-leaf hot path).
+fn sub8_enabled() -> bool {
+    use std::sync::OnceLock;
+    static S: OnceLock<bool> = OnceLock::new();
+    *S.get_or_init(|| {
+        matches!(
+            std::env::var("RVP9_SUB8").ok().as_deref(),
+            Some("1") | Some("on") | Some("true") | Some("yes")
+        )
+    })
+}
+
+/// SUB8 — RD-decision acceptance margin (percent). The picker's Y-only,
+/// start-of-block `coeff_ctx = 0` RD systematically UNDER-prices the
+/// sub-8x8 candidate (4 separate blocks each costed as start-of-block,
+/// chroma excluded, and a crude per-sub-block NEWMV search rather than
+/// libvpx's joint search), so a naive `sub8_rd < single_rd` comparison
+/// over-selects sub-8x8 and net-REGRESSES at matched bitrate on foreman
+/// (~-0.13 dB @ 500k). This margin tightens the acceptance cap to
+/// `single_rd * (1 - margin)` so sub-8x8 only wins by a clear margin;
+/// higher margins emit fewer sub-8x8 leaves and asymptote toward the
+/// (byte-identical) OFF baseline. Empirically even margin 60 stays
+/// slightly negative on foreman — the feature does not beat the
+/// single-8x8 path with this simplified RD. Default 40 (near-neutral);
+/// `RVP9_SUB8_MARGIN=0` restores the raw (over-eager) comparison.
+fn sub8_margin_pct() -> u32 {
+    use std::sync::OnceLock;
+    static S: OnceLock<u32> = OnceLock::new();
+    *S.get_or_init(|| {
+        std::env::var("RVP9_SUB8_MARGIN")
+            .ok()
+            .and_then(|v| v.parse::<u32>().ok())
+            .unwrap_or(40)
+            .min(95)
+    })
+}
+
 /// Splat a single inter leaf's [`rvp9_core::mode_info::ModeInfo`] into
 /// every 8x8 cell the leaf covers in the in-progress mi_grid used by
 /// the A2.foreman spatial MV-ref propagation. Mirrors
