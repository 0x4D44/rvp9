+/// The greatest source offset used by an interpolation pass is in its last
+/// row. A successful checked extent also proves every intermediate row and
+/// chunk offset can be formed without overflow, even when rows overlap.
+#[cfg(target_arch = "x86_64")]
+fn source_footprint_fits(src_len: usize, stride: usize, rows: usize, row_width: usize) -> bool {
+    rows.checked_sub(1)
+        .and_then(|last_row| last_row.checked_mul(stride))
+        .and_then(|base| base.checked_add(row_width))
+        .is_some_and(|end| end <= src_len)
+}
+
+/// Load an exact-width chunk after one whole-pass footprint proof. The
+/// checked specialization retains the original malformed-input behaviour.
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2")]
+unsafe fn load_bytes<const PROVEN: bool>(src: &[u8], off: usize, count: usize) -> __m128i {
+    if !PROVEN {
+        return load_bytes_bounded(src, off, count);
+    }
+    // SAFETY: the caller selected PROVEN only after checking the entire
+    // source footprint. Every chunk reads at most `count` bytes within its
+    // row, including the right-neighbour byte and an exact-width tail.
+    let ptr = src.as_ptr().add(off) as *const __m128i;
+    match count {
+        16 => _mm_loadu_si128(ptr),
+        8 => _mm_loadl_epi64(ptr),
+        4 => _mm_cvtsi32_si128(core::ptr::read_unaligned(ptr as *const i32)),
+        _ => load_bytes_bounded(src, off, count),
+    }
+}
