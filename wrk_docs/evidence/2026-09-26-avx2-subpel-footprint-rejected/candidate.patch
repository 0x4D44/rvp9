+    /// The fast path must read no more than the phase's actual footprint.
+    /// Compare against the scalar oracle on an extended copy because that
+    /// oracle conservatively requires the full two-dimensional footprint.
+    #[test]
+    fn differential_exact_source_footprints() {
+        require_avx2!();
+        let mut rng = Lcg32::new(0x5A_1E_2026);
+        for &(w, h) in SHAPES {
+            for stride_extra in [0, 3] {
+                let src_stride = w + 1 + stride_extra;
+                let ref_stride = w + 2;
+                let reference: Vec<u8> = (0..(h - 1) * ref_stride + w)
+                    .map(|_| rng.next_byte())
+                    .collect();
+                for yoff in 0..8 {
+                    for xoff in 0..8 {
+                        let rows = if yoff == 0 { h } else { h + 1 };
+                        let row_width = if xoff == 0 { w } else { w + 1 };
+                        let exact_len = (rows - 1) * src_stride + row_width;
+                        let src: Vec<u8> = (0..exact_len).map(|_| rng.next_byte()).collect();
+                        let mut extended = src.clone();
+                        extended.resize(h * src_stride + w + 1, 0xA7);
+                        let expected = scalar_svf(
+                            &extended, src_stride, &reference, ref_stride, xoff, yoff, w, h,
+                        );
+                        let actual = sub_pixel_variance_avx2(
+                            &src, src_stride, &reference, ref_stride, xoff, yoff, w, h,
+                        );
+                        assert_eq!(actual, expected, "shape={w}x{h} phase={xoff},{yoff}");
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn truncated_source_uses_checked_fallback() {
+        require_avx2!();
+        let (w, h) = (4, 4);
+        let stride = w + 1;
+        let reference = vec![3u8; w * h];
+        for (xoff, yoff, rows, row_width) in
+            [(1, 0, h, w + 1), (0, 1, h + 1, w), (1, 1, h + 1, w + 1)]
+        {
+            let exact_len = (rows - 1) * stride + row_width;
+            let src = vec![17u8; exact_len - 1];
+            let result = std::panic::catch_unwind(|| {
+                sub_pixel_variance_avx2(&src, stride, &reference, w, xoff, yoff, w, h)
+            });
+            assert!(result.is_err(), "short source escaped phase={xoff},{yoff}");
+        }
+        assert!(!source_footprint_fits(usize::MAX, usize::MAX, 4, 4));
+    }
