+static INLINE void model_rd_census_small_branch(BLOCK_SIZE bsize,
+                                                int skip_txfm, int skip_dc) {
+  MODEL_RD_SMALL_CENSUS *const c = &model_rd_small_census[bsize];
+  if (skip_txfm == SKIP_TXFM_AC_DC)
