@@ -15173,0 +15329,32 @@ mod tests {
+    #[test]
+    fn tx_reuse_ceiling_counter_aggregation_is_deterministic() {
+        let mut first = TxReuseCeilingDiagnostics::default();
+        let tx4 = first.record_selector(TxSize::Tx4x4);
+        first.record_luma_skip(tx4);
+        first.record_final_skip(tx4);
+        let tx8 = first.record_selector(TxSize::Tx8x8);
+        first.record_luma_traversed(tx8);
+        // The residual walk records each tile once, then records nonzero
+        // residuals through the separate counter path.
+        first.record_luma_tile(tx8);
+        first.record_luma_tile(tx8);
+        first.record_luma_nonzero_tile(tx8);
+
+        let mut second = TxReuseCeilingDiagnostics::default();
+        let tx16 = second.record_selector(TxSize::Tx16x16);
+        second.record_luma_traversed(tx16);
+        second.record_luma_tile(tx16);
+        second.record_luma_nonzero_tile(tx16);
+        second.record_final_skip(tx16);
+
+        first.merge_from(second);
+
+        assert_eq!(first.selector_calls, 3);
+        assert_eq!(first.chosen_tx, [1, 1, 1, 0]);
+        assert_eq!(first.luma_skip_leaves, [1, 0, 0, 0]);
+        assert_eq!(first.luma_traversed_leaves, [0, 1, 1, 0]);
+        assert_eq!(first.luma_tiles, [0, 2, 1, 0]);
+        assert_eq!(first.luma_nonzero_tiles, [0, 1, 1, 0]);
+        assert_eq!(first.final_skip_leaves, [1, 0, 1, 0]);
+    }
