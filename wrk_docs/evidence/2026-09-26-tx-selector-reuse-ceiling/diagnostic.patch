+/// Aggregate counters for the optional transform-selector reuse-ceiling
+/// diagnostic. These counters are kept separate from codec state so the
+/// diagnostic cannot affect bitstream decisions or entropy order.
+#[derive(Debug, Default, Eq, PartialEq)]
+struct TxReuseCeilingDiagnostics {
+    selector_calls: usize,
+    chosen_tx: [usize; 4],
+    luma_skip_leaves: [usize; 4],
+    luma_traversed_leaves: [usize; 4],
+    luma_tiles: [usize; 4],
+    luma_nonzero_tiles: [usize; 4],
+    final_skip_leaves: [usize; 4],
+}
+
+impl TxReuseCeilingDiagnostics {
+    #[inline]
+    fn record_selector(&mut self, tx_size: TxSize) -> usize {
+        let index = tx_size as usize;
+        debug_assert!(index < self.chosen_tx.len());
+        self.selector_calls += 1;
+        self.chosen_tx[index] += 1;
+        index
+    }
+
+    #[inline]
+    fn record_luma_skip(&mut self, tx_index: usize) {
+        self.luma_skip_leaves[tx_index] += 1;
+    }
+
+    #[inline]
+    fn record_luma_traversed(&mut self, tx_index: usize) {
+        self.luma_traversed_leaves[tx_index] += 1;
+    }
+
+    #[inline]
+    fn record_luma_tile(&mut self, tx_index: usize) {
+        self.luma_tiles[tx_index] += 1;
+    }
+
+    #[inline]
+    fn record_luma_nonzero_tile(&mut self, tx_index: usize) {
+        self.luma_nonzero_tiles[tx_index] += 1;
+    }
+
+    #[inline]
+    fn record_final_skip(&mut self, tx_index: usize) {
+        self.final_skip_leaves[tx_index] += 1;
+    }
+
+    fn merge_from(&mut self, other: Self) {
+        self.selector_calls += other.selector_calls;
+        for (dst, src) in self.chosen_tx.iter_mut().zip(other.chosen_tx) {
+            *dst += src;
+        }
+        for (dst, src) in self.luma_skip_leaves.iter_mut().zip(other.luma_skip_leaves) {
+            *dst += src;
+        }
+        for (dst, src) in self
+            .luma_traversed_leaves
+            .iter_mut()
+            .zip(other.luma_traversed_leaves)
+        {
+            *dst += src;
+        }
+        for (dst, src) in self.luma_tiles.iter_mut().zip(other.luma_tiles) {
+            *dst += src;
+        }
+        for (dst, src) in self
+            .luma_nonzero_tiles
+            .iter_mut()
+            .zip(other.luma_nonzero_tiles)
+        {
+            *dst += src;
+        }
+        for (dst, src) in self
+            .final_skip_leaves
+            .iter_mut()
+            .zip(other.final_skip_leaves)
+        {
+            *dst += src;
+        }
+    }
+}
