@@ -163,0 +164,12 @@ impl MetricAccumulator {
+    #[inline]
+    #[target_feature(enable = "sse2")]
+    unsafe fn add_zero(&mut self, coeff: __m128i) {
+        let zero = _mm_setzero_si128();
+        let pair_squares = _mm_madd_epi16(coeff, coeff);
+        // Two i16::MIN squares can set bit 31; widen the pair as unsigned.
+        self.error_even_lo =
+            _mm_add_epi64(self.error_even_lo, _mm_unpacklo_epi32(pair_squares, zero));
+        self.error_odd_lo =
+            _mm_add_epi64(self.error_odd_lo, _mm_unpackhi_epi32(pair_squares, zero));
+    }
