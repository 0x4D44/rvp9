+    (
+        NSTEP_CALLS.load(Ordering::Relaxed),
+        NSTEP_DIAMOND_STARTS.load(Ordering::Relaxed),
+        NSTEP_MAX_EXTRA_STARTS.load(Ordering::Relaxed),
+    )
