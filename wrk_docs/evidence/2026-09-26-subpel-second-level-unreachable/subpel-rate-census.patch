+#[allow(clippy::too_many_arguments)]
+fn check_second_level(
+    r: i32,
+    c: i32,
+    br: &mut i32,
+    bc: &mut i32,
+    besterr: &mut u32,
+    params: &SubPixelSearchParams<'_>,
+    svf: SvfFn,
+    bw: usize,
+    bh: usize,
+    subpel_limits: &MvLimits,
+) -> u32 {
+    let idx = params.block_size.idx();
+    SECOND_LEVEL_ATTEMPTS[idx].fetch_add(1, Ordering::Relaxed);
+    if r >= subpel_limits.row_min
+        && r <= subpel_limits.row_max
+        && c >= subpel_limits.col_min
+        && c <= subpel_limits.col_max
+    {
+        SECOND_LEVEL_VALID[idx].fetch_add(1, Ordering::Relaxed);
+        let rate = mv_err_cost(
+            r as i16,
+            c as i16,
+            params.ref_mv.row,
+            params.ref_mv.col,
+            params.error_per_bit,
+            params.mv_costs,
+        );
+        if rate >= *besterr {
+            SECOND_LEVEL_RATE_REJECTS[idx].fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    check(r, c, br, bc, besterr, params, svf, bw, bh, subpel_limits)
+}
