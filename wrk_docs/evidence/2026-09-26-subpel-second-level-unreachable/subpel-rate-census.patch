+/// Diagnostic counts by VP9 block-size index: attempted, MV-valid, and
+/// candidates whose MV cost alone cannot beat the current best score.
+pub fn second_level_rate_reject_census() -> [[u64; 3]; 13] {
+    std::array::from_fn(|i| {
+        [
+            SECOND_LEVEL_ATTEMPTS[i].load(Ordering::Relaxed),
+            SECOND_LEVEL_VALID[i].load(Ordering::Relaxed),
+            SECOND_LEVEL_RATE_REJECTS[i].load(Ordering::Relaxed),
+        ]
+    })
+}
 
