+/// Run the output-backed inter picker when no temporal denoiser consumes its
+/// candidate statistics. The mode decision and retained prediction match
+/// [`pick_inter_mode_with_output`], while the returned denoiser context is empty.
+#[must_use]
+pub fn pick_inter_mode_with_output_without_denoiser(
+    params: &PickInterModeParams<'_>,
+    output: &mut OutputBackedPredictionBuffer<'_>,
+) -> PickInterModeResult {
+    output.assert_capacity(
+        usize::from(params.block_size.width()),
+        usize::from(params.block_size.height()),
+    );
+    pick_inter_mode_impl(
+        params,
+        Some(output),
+        reuse_single_ref_params_enabled(),
+        false,
+    )
 }

