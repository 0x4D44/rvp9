+    #[test]
+    fn prepared_seed_matches_fresh_diamond_at_every_nstep_start() {
+        let costs = build_nmv_cost_table(&DEFAULT_NMV_CONTEXT, true);
+        let width = 64usize;
+        let height = 64usize;
+        let cfg = init_dsmotion_compensation(width as i32);
+        let reference = make_plane(width, height, 0x5EED);
+        let mut source = reference.clone();
+        for row in 0..16 {
+            for col in 0..16 {
+                source[(24 + row) * width + 24 + col] = reference[(25 + row) * width + 26 + col];
+            }
+        }
+        let src_plane = PlaneRef {
+            data: &source,
+            stride: width,
+            width,
+            height,
+        };
+        let ref_plane = PlaneRef {
+            data: &reference,
+            stride: width,
+            width,
+            height,
+        };
+        let mut checks = 0;
+        for (offset, start_mv) in [
+            ((24, 24), Some(Mv::ZERO)),
+            ((0, 0), Some(Mv { row: -8, col: -8 })),
+        ] {
+            let params = FullPixelSearchParams {
+                block_size: BlockSize::Block16x16,
+                src_plane: &src_plane,
+                src_offset: offset,
+                ref_plane: &ref_plane,
+                center_mv: Mv::ZERO,
+                start_mv,
+                mv_limits: MvLimits::new(-16, 16, -16, 16),
+                sad_per_bit: 1,
+                mv_costs: &costs,
+                max_iters: cfg.total_steps as i32,
+                site_config: &cfg,
+            };
+            let prepared = prepare_diamond_seed(&params);
+            if offset == (0, 0) {
+                assert_eq!(prepared.initial_sad, u32::MAX);
+            } else {
+                assert_ne!(prepared.initial_sad, u32::MAX);
+            }
+            for start_step in 6..cfg.total_steps as usize {
+                let fresh = diamond_search_sad_from_step(&params, start_step);
+                let reused = diamond_search_sad_from_step_with_seed(&params, start_step, &prepared);
+                assert_eq!(reused, fresh, "offset={offset:?} start_step={start_step}");
+                checks += 1;
+            }
+            assert_eq!(
+                nstep_search_sad(&params),
+                nstep_uncached_reference(&params).0
+            );
+        }
+        assert_eq!(
+            checks, 10,
+            "both valid and clipped seeds must reach every start"
+        );
+    }
