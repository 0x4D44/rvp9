+    /// The 16-wide direct vertical pass must retain the scalar temp even
+    /// when the final source row ends exactly at the bilinear footprint.
+    #[test]
+    fn differential_vertical_16_row_carry_tight_source() {
+        require_avx2!();
+        let mut rng = Lcg32::new(0x16_7011);
+        for h in [8, 16, 32] {
+            for src_stride in [17, 23] {
+                let src_len = h * src_stride + 17;
+                let src: Vec<u8> = (0..src_len).map(|_| rng.next_byte()).collect();
+                for yoff in 0..8 {
+                    let expected = scalar_bilinear_temp(&src, src_stride, 0, yoff, 16, h);
+                    let mut actual = vec![0u8; h * 16];
+                    // SAFETY: the AVX2 check above guards this call. The source
+                    // has all h+1 rows, including the final 17-byte footprint.
+                    unsafe {
+                        vertical_bilinear_from_source(&src, src_stride, yoff, 16, h, &mut actual);
+                    }
+                    assert_eq!(actual, expected, "h={h}, stride={src_stride}, yoff={yoff}");
+                }
+            }
+        }
+    }
