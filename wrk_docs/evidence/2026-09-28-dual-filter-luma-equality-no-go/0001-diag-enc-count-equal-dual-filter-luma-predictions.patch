+// ---------------------------------------------------------------------
+// Opt-in two-filter luma-prediction equality census. The selector is called
+// from tile workers, so the diagnostic uses process-wide relaxed atomics. The
+// default path performs no predictor comparison and does not touch a counter.
+
+const DUAL_FILTER_LUMA_PREDICTION_DIAG_ENV: &str = "RVP9_DIAG_DUAL_FILTER_EQUALITY";
+
+/// Aggregate counts from the opt-in two-filter luma-prediction census.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct DualFilterLumaPredictionCounts {
+    /// Two-filter candidate pairs for which both luma predictors were built.
+    pub evaluated_pairs: u64,
+    /// Evaluated pairs whose active luma predictor bytes were identical.
+    pub identical_pairs: u64,
+}
+
+struct DualFilterLumaPredictionCounters {
+    evaluated_pairs: std::sync::atomic::AtomicU64,
+    identical_pairs: std::sync::atomic::AtomicU64,
+}
+
+impl DualFilterLumaPredictionCounters {
+    const fn new() -> Self {
+        Self {
+            evaluated_pairs: std::sync::atomic::AtomicU64::new(0),
+            identical_pairs: std::sync::atomic::AtomicU64::new(0),
+        }
+    }
+}
+
+static DUAL_FILTER_LUMA_PREDICTION_COUNTERS: DualFilterLumaPredictionCounters =
+    DualFilterLumaPredictionCounters::new();
+
+#[inline]
+fn dual_filter_luma_prediction_diag_enabled() -> bool {
+    use std::sync::OnceLock;
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os(DUAL_FILTER_LUMA_PREDICTION_DIAG_ENV).is_some())
+}
+
+#[inline]
+fn record_dual_filter_luma_prediction_pair(identical: bool) {
+    if !dual_filter_luma_prediction_diag_enabled() {
+        return;
+    }
+    use std::sync::atomic::Ordering;
+    DUAL_FILTER_LUMA_PREDICTION_COUNTERS
+        .evaluated_pairs
+        .fetch_add(1, Ordering::Relaxed);
+    if identical {
+        DUAL_FILTER_LUMA_PREDICTION_COUNTERS
+            .identical_pairs
+            .fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Return the opt-in two-filter luma-prediction census as one CLI report.
+/// `None` means `RVP9_DIAG_DUAL_FILTER_EQUALITY` was not set.
+#[must_use]
+pub fn dual_filter_luma_prediction_census_report() -> Option<String> {
+    if !dual_filter_luma_prediction_diag_enabled() {
+        return None;
+    }
+    let counts = dual_filter_luma_prediction_counts();
+    Some(format!(
+        "dual_filter_luma_prediction evaluated_pairs={} identical_pairs={}",
+        counts.evaluated_pairs, counts.identical_pairs,
+    ))
+}
+
+/// Read the opt-in two-filter luma-prediction counters without resetting them.
+#[must_use]
+pub fn dual_filter_luma_prediction_counts() -> DualFilterLumaPredictionCounts {
+    use std::sync::atomic::Ordering;
+    DualFilterLumaPredictionCounts {
+        evaluated_pairs: DUAL_FILTER_LUMA_PREDICTION_COUNTERS
+            .evaluated_pairs
+            .load(Ordering::Relaxed),
+        identical_pairs: DUAL_FILTER_LUMA_PREDICTION_COUNTERS
+            .identical_pairs
+            .load(Ordering::Relaxed),
+    }
+}
+
