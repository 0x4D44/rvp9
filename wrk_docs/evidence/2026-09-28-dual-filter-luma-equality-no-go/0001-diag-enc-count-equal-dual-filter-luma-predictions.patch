+/// Compare the active luma pixels in two filter-prediction slots. Scratch
+/// slots are tight (`bw` stride); the caller-owned output may have padding,
+/// which is intentionally excluded from the equality census.
+fn dual_filter_luma_predictions_equal(
+    primary: &[u8; 64 * 64],
+    alternate: &[u8; 64 * 64],
+    output: Option<&OutputBackedPredictionBuffer<'_>>,
+    prediction_slots: [FilterPredictionSlot; 2],
+    bw: usize,
+    bh: usize,
+) -> bool {
+    for row in 0..bh {
+        for col in 0..bw {
+            let pixel = |slot| match slot {
+                FilterPredictionSlot::Candidate => primary[row * bw + col],
+                FilterPredictionSlot::Alternate => alternate[row * bw + col],
+                FilterPredictionSlot::Output => {
+                    let output = output.expect("output slot requires output-backed picker");
+                    output.data[row * output.stride + col]
+                }
+            };
+            if pixel(prediction_slots[0]) != pixel(prediction_slots[1]) {
+                return false;
+            }
+        }
+    }
+    true
+}
