+    #[test]
+    fn dual_filter_luma_prediction_equality_ignores_output_padding() {
+        use FilterPredictionSlot::{Alternate, Candidate, Output};
+
+        let bw = 4;
+        let bh = 3;
+        let stride = 7;
+        let mut primary = [0u8; 64 * 64];
+        let mut alternate = [0u8; 64 * 64];
+        let mut output_storage = vec![0xA5; stride * bh];
+        for row in 0..bh {
+            for col in 0..bw {
+                let pixel = (row * bw + col) as u8;
+                primary[row * bw + col] = pixel;
+                alternate[row * bw + col] = pixel;
+                output_storage[row * stride + col] = pixel;
+            }
+        }
+        let output = OutputBackedPredictionBuffer::new(&mut output_storage, stride);
+
+        for slots in [
+            [Candidate, Alternate],
+            [Output, Candidate],
+            [Candidate, Output],
+            [Output, Alternate],
+            [Alternate, Output],
+        ] {
+            assert!(dual_filter_luma_predictions_equal(
+                &primary,
+                &alternate,
+                Some(&output),
+                slots,
+                bw,
+                bh,
+            ));
+        }
+
+        // Row padding is intentionally different, but it is outside the
+        // active `bw × bh` predictor and must not affect the census.
+        output.data[4] = 0x5A;
+        assert!(dual_filter_luma_predictions_equal(
+            &primary,
+            &alternate,
+            Some(&output),
+            [Output, Candidate],
+            bw,
+            bh,
+        ));
+        output.data[stride + 2] ^= 1;
+        assert!(!dual_filter_luma_predictions_equal(
+            &primary,
+            &alternate,
+            Some(&output),
+            [Output, Candidate],
+            bw,
+            bh,
+        ));
+    }
+
